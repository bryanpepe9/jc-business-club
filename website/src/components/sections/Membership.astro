---
import type { SiteContent } from '@/i18n/types';
import Section from '@/components/layout/Section.astro';
import SectionHeader from '@/components/layout/SectionHeader.astro';
import Button from '@/components/ui/Button.astro';

interface Props {
  content: SiteContent;
}

const { membership } = Astro.props.content;
const { price } = membership;
---

<Section intro={membership.intro} theme="graphite" labelledby="membership-title">
  <SectionHeader intro={membership.intro} />

  <div class="membership layout-grid">
    <div class="membership__intro" data-reveal>
      <h2 id="membership-title" class="t-h2">
        {membership.title}
      </h2>
      <p class="membership__statement t-lead">{membership.statement}</p>
    </div>

    <div class="membership__offer" data-reveal>
      <p class="label membership__price-label">{price.label}</p>
      <p class="membership__price">
        <span class="membership__amount" aria-hidden="true">
          {price.amount}
          <span class="membership__period">{price.period}</span>
        </span>
        <span class="visually-hidden">{price.spoken}</span>
      </p>
      <ul class="membership__inclusions" role="list">
        {membership.inclusions.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </div>

    <!-- After the offer in source order, so small screens read price → action. -->
    <div class="membership__action" data-reveal>
      <Button href={membership.cta.href} arrow>
        {membership.cta.label}
      </Button>
      {membership.selectionNote && <p class="membership__note">{membership.selectionNote}</p>}
    </div>
  </div>
</Section>

<style>
  .membership__statement {
    margin-top: clamp(1.5rem, 1rem + 1.5vw, 2.5rem);
    max-width: 40ch;
    color: var(--fg-muted);
  }

  .membership__action :global(.btn) {
    width: 100%;
  }

  .membership__note {
    margin-top: var(--space-4);
    font-size: var(--text-small);
    color: var(--fg-muted);
  }

  .membership__price-label {
    color: var(--fg-muted);
  }

  .membership__price {
    margin-top: var(--space-3);
    font-family: var(--font-serif);
    font-size: clamp(4rem, 2.6rem + 5.5vw, 7.5rem);
    font-weight: 200;
    line-height: 1;
    letter-spacing: -0.03em;
    font-variant-numeric: lining-nums;
    white-space: nowrap;
  }

  /* Flex drops the whitespace between amount and period. */
  .membership__amount {
    display: inline-flex;
    align-items: baseline;
  }

  .membership__period {
    margin-left: 0.08em;
    font-size: 0.32em;
    font-weight: 300;
    letter-spacing: 0;
    color: var(--fg-muted);
  }

  .membership__inclusions {
    margin-top: var(--space-6);
    border-top: var(--hairline) solid var(--line);
  }

  .membership__inclusions li {
    padding-block: var(--space-4);
    border-bottom: var(--hairline) solid var(--line);
  }

  .membership__inclusions li:first-child {
    color: var(--accent);
  }

  @media (min-width: 40rem) {
    .membership__action :global(.btn) {
      width: auto;
    }
  }

  @media (min-width: 64rem) {
    .membership {
      /* The offer spans all rows; the flexible last row absorbs its extra
         height so the heading and button stay together. */
      grid-template-rows: auto auto 1fr;
      row-gap: clamp(2rem, 1.5rem + 2vw, 3rem);
    }

    .membership__intro {
      grid-column: 1 / span 6;
      grid-row: 1;
    }

    .membership__action {
      grid-column: 1 / span 6;
      grid-row: 2;
    }

    .membership__offer {
      grid-column: 8 / span 5;
      grid-row: 1 / span 3;
    }
  }
</style>

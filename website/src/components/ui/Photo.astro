---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** CSS aspect-ratio. The image is cropped to fill it. */
  ratio?: '4 / 5' | '3 / 2' | '3 / 4' | '16 / 9' | 'auto';
  /** Rendered width hint for the browser, e.g. "(min-width: 64rem) 40vw, 100vw". */
  sizes: string;
  widths?: number[];
  /** Above-the-fold image: eager loading and high fetch priority. */
  priority?: boolean;
  position?: string;
  class?: string;
}

const {
  src,
  alt,
  ratio = 'auto',
  sizes,
  widths,
  priority = false,
  position = 'center',
  class: className,
} = Astro.props;

// Never request a variant larger than the source.
const candidateWidths = widths ?? [480, 720, 960, 1280, 1600];
const resolvedWidths = [...new Set([...candidateWidths.filter((w) => w < src.width), src.width])];
---

<div class:list={['photo', className]} style={`--ratio: ${ratio}; --position: ${position};`}>
  <Picture
    src={src}
    alt={alt}
    formats={['avif', 'webp']}
    widths={resolvedWidths}
    sizes={sizes}
    priority={priority}
    quality={78}
  />
</div>

<style>
  .photo {
    position: relative;
    overflow: hidden;
    background: var(--photo-bg);
    aspect-ratio: var(--ratio);
  }

  .photo :global(picture) {
    display: block;
    height: 100%;
  }

  .photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--position);
  }
</style>

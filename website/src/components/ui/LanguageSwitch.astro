---
/**
 * Links to this page in the other language(s). Visible text is the short code
 * ("EN"); the accessible name starts with it and adds the language's own name.
 */
import { LANGUAGE_NAMES, LOCALES, type Locale } from '@/config/site';

interface Props {
  locale: Locale;
  alternates: Record<Locale, string>;
  label: string;
  /** "other": only the other language(s). "all": every language, current marked. */
  show?: 'other' | 'all';
  class?: string;
}

const { locale, alternates, label, show = 'other', class: className } = Astro.props;
const locales = show === 'all' ? LOCALES : LOCALES.filter((l) => l !== locale);
---

<nav class:list={['lang-switch', className]} aria-label={label}>
  <ul role="list">
    {locales.map((l) => (
      <li>
        <a href={alternates[l]} hreflang={l} lang={l} aria-current={l === locale ? 'true' : undefined}>
          {LANGUAGE_NAMES[l].short}
          <span class="visually-hidden">{` — ${LANGUAGE_NAMES[l].name}`}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .lang-switch ul {
    display: flex;
    gap: var(--space-4);
  }

  .lang-switch a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    min-width: 2.75rem;
    justify-content: center;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    color: var(--fg-muted);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .lang-switch a:hover,
  .lang-switch a[aria-current] {
    color: var(--fg);
  }

  .lang-switch a[aria-current] {
    text-decoration: underline;
    text-decoration-color: var(--accent-decor);
    text-underline-offset: 0.4em;
  }
</style>

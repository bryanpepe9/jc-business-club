---
interface Props {
  direction?: 'right' | 'up-right' | 'down';
  class?: string;
}
const { direction = 'right', class: className } = Astro.props;
---

<svg
  class:list={['arrow', `arrow--${direction}`, className]}
  width="16"
  height="16"
  viewBox="0 0 16 16"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <path
    d="M2 8h11M9 3.5 13.5 8 9 12.5"
    stroke="currentColor"
    stroke-width="1.25"
    stroke-linecap="square"
  ></path>
</svg>

<style>
  .arrow {
    flex: none;
    width: 1em;
    height: 1em;
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .arrow--up-right {
    rotate: -45deg;
  }

  .arrow--down {
    rotate: 90deg;
  }
</style>

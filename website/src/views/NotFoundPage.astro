---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArrowLink from '@/components/ui/ArrowLink.astro';
import { getContent } from '@/i18n';
import type { Locale } from '@/config/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { notFound } = getContent(locale);
---

<BaseLayout locale={locale} title={notFound.title} noindex>
  <section class="not-found theme-ink" aria-labelledby="not-found-title">
    <div class="container">
      <p class="not-found__code label" aria-hidden="true">
        404
      </p>
      <h1 id="not-found-title" class="t-h2">
        {notFound.title}
      </h1>
      <p class="not-found__body t-lead">{notFound.body}</p>
      <ArrowLink href={notFound.back.href}>{notFound.back.label}</ArrowLink>
      {notFound.otherLanguage && (
        <p class="not-found__other" lang={notFound.otherLanguage.lang}>
          <a href={notFound.otherLanguage.href}>{notFound.otherLanguage.label}</a>
        </p>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    min-height: calc(70svh - var(--header-h));
    display: grid;
    align-items: center;
    padding-block: var(--section-pad);
    background: var(--bg);
    color: var(--fg);
  }

  .not-found__code {
    color: var(--accent);
    margin-bottom: var(--space-4);
  }

  .not-found__body {
    margin-block: var(--space-5) var(--space-6);
    color: var(--fg-muted);
  }

  .not-found__other {
    margin-top: var(--space-6);
    font-size: var(--text-small);
    color: var(--fg-muted);
  }
</style>

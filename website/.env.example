# Copy to `.env` for local work (git-ignored). On Vercel, set the same names in
# Project → Settings → Environment Variables. Leave everything empty locally to
# use development mode: submissions are printed to the terminal, nothing is sent.

# Absolute site URL (defaults to https://clube.jccapital.com.br).
# SITE_URL=

# Cloudflare Turnstile (spam protection). Site key is public; secret is not.
# Local testing: Cloudflare's always-pass test keys
#   PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend (email delivery). The "from" address must use a verified domain.
RESEND_API_KEY=
APPLICATION_TO_EMAIL=
APPLICATION_FROM_EMAIL=
